{
  "steps": [
    {
      "type": "navigate",
      "url": "https://pintinc.jp/login"
    },
    {
      "type": "wait",
      "milliseconds": "3000"
    },
    {
      "type": "input",
      "selector": "#id_email",
      "env": "LOGIN_ID"
    },
    {
      "type": "input",
      "selector": "#id_password",
      "env": "PASSWORD"
    },
    {
      "type": "click",
      "selector": "button.login"
    },
    {
      "type": "wait",
      "milliseconds": "3000"
    },
    {
      "type": "screenshot",
      "filename": "after-login.png"
    }
  ]
}