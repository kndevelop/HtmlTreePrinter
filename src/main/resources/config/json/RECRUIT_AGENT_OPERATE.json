{
  "steps": [
    {
      "type": "navigate",
      "url": "https://mypage.r-agent.com/rikupon/login"
    },
    {
      "type": "input",
      "selector": "#mainEmail",
      "value": "${USER_NAME}"
    },
    {
      "type": "input",
      "selector": "#passwd1",
      "value": "${PASSWORD}"
    },
    {
      "type": "click",
      "selector": "#sbmbtn"
    },
    {
      "type": "wait",
      "milliseconds": 3000
    },
    {
      "type": "navigate",
      "url": "https://example.com/search"
    },
    {
      "type": "input",
      "selector": "#keyword",
      "value": "東京"
    },
    {
      "type": "click",
      "selector": "#searchButton"
    },
    {
      "type": "extract",
      "name": "resultCount",
      "selector": "#resultCount"
    }
  ]
}